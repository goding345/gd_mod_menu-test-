{
	"geode": "5.11.2",
	"gd": {
		"win": "*",
		"android": "*"
	},
	"id": "user.autojump",
	"name": "Mod Menu",
	"version": "v3.0.0",
	"developer": "user",
	"description": "Menu on Tab: cheats, auto bot, macros, icon hack, rainbow icon, FPS/clock, visual effects.",
	"settings": {
		"enabled": {
			"type": "bool",
			"name": "Bot enabled",
			"default": false
		},
		"mode": {
			"type": "string",
			"name": "Bot mode",
			"description": "Auto bot = plays cube/wave by itself. Record macro = record your run. Replay macro = plays the saved run.",
			"default": "Auto bot",
			"one-of": [
				"Auto bot",
				"Record macro",
				"Replay macro"
			]
		},
		"legit": {
			"type": "int",
			"name": "Mistakes level",
			"description": "Auto bot only. 0 = perfect, 10 = human-like mistakes.",
			"default": 0,
			"min": 0,
			"max": 10,
			"control": {
				"slider": true
			}
		},
		"noclip": {
			"type": "bool",
			"name": "Noclip",
			"default": false
		},
		"speed": {
			"type": "float",
