{
	"geode": "5.11.2",
	"gd": {
		"win": "*",
		"android": "*"
	},
	"id": "user.autojump",
	"name": "Mod Menu",
	"version": "v2.3.0",
	"developer": "user",
	"description": "Menu on Tab: cheats, auto bot, macros, icon hack, rainbow icon, FPS/clock, visual effects.",
	"settings": {
		"enabled": {
			"type": "bool",
			"name": "Bot enabled",
			"default": false
		},
		"mode": {
			"type": "string",
			"name": "Bot mode",
			"description": "Auto bot = plays cube/wave by itself. Record macro = record your run. Replay macro = plays the saved run.",
			"default": "Auto bot",
			"one-of": [
				"Auto bot",
				"Record macro",
				"Replay macro"
			]
		},
		"legit": {
			"type": "int",
			"name": "Mistakes level",
			"description": "Auto bot only. 0 = perfect, 10 = human-like mistakes.",
			"default": 0,
			"min": 0,
			"max": 10,
			"control": {
				"slider": true
			}
		},
		"noclip": {
			"type": "bool",
			"name": "Noclip",
			"default": false
		},
		"speed": {
			"type": "float",
			"name": "Speedhack",
			"default": 1.0,
			"min": 0.1,
			"max": 5.0
		},
		"safe-mode": {
			"type": "bool",
			"name": "Safe mode",
			"description": "Blocks level completion if cheats were on during the attempt.",
			"default": true
		},
		"jumphack": {
			"type": "bool",
			"name": "Jump hack",
			"default": false
		},
		"autoclick": {
			"type": "bool",
			"name": "Autoclicker",
			"default": false
		},
		"cps": {
			"type": "int",
			"name": "Autoclicker CPS",
			"default": 10,
			"min": 1,
			"max": 30
		},
		"indicator": {
			"type": "bool",
			"name": "Cheat indicator",
			"default": true
		},
		"hide-player": {
			"type": "bool",
			"name": "Hide player",
			"default": false
		},
		"hide-wave": {
			"type": "bool",
			"name": "Hide wave trail",
			"default": false
		},
		"solid-wave": {
			"type": "bool",
			"name": "Solid wave trail",
			"default": false
		},
		"fx-snow": {
			"type": "int",
			"name": "Snow",
			"default": 0,
			"min": 0,
			"max": 10
		},
		"fx-rain": {
			"type": "int",
			"name": "Rain",
			"default": 0,
			"min": 0,
			"max": 10
		},
		"fx-fireflies": {
			"type": "int",
			"name": "Fireflies",
			"default": 0,
			"min": 0,
			"max": 10
		},
		"fx-stretch-x": {
			"type": "float",
			"name": "Stretch X",
			"default": 1.0,
			"min": 0.3,
			"max": 3.0
		},
		"fx-stretch-y": {
			"type": "float",
			"name": "Stretch Y",
			"default": 1.0,
			"min": 0.3,
			"max": 3.0
		},
		"fx-zoom": {
			"type": "float",
			"name": "Zoom",
			"default": 1.0,
			"min": 0.3,
			"max": 3.0
		},
		"fx-tilt": {
			"type": "int",
			"name": "Tilt (deg)",
			"default": 0,
			"min": -45,
			"max": 45
		},
		"fx-tint": {
			"type": "int",
			"name": "Rainbow tint",
			"default": 0,
			"min": 0,
			"max": 10
		},
		"fx-vignette": {
			"type": "int",
			"name": "Vignette",
			"default": 0,
			"min": 0,
			"max": 10
		},
		"fx-wobble": {
			"type": "int",
			"name": "Wobble",
			"default": 0,
			"min": 0,
			"max": 10
		},
		"fx-shake": {
			"type": "int",
			"name": "Camera shake",
			"default": 0,
			"min": 0,
			"max": 10
		},
		"fx-pulse": {
			"type": "int",
			"name": "Pulse",
			"default": 0,
			"min": 0,
			"max": 10
		},
		"icon-hack": {
			"type": "bool",
			"name": "Icon hack",
			"description": "All icons and colors count as unlocked.",
			"default": false
		},
		"rainbow-icon": {
			"type": "bool",
			"name": "Rainbow icon",
			"default": false
		},
		"rainbow-speed": {
			"type": "int",
			"name": "Rainbow speed",
			"default": 5,
			"min": 1,
			"max": 10
		},
		"restart-key": {
			"type": "bool",
			"name": "Restart on R",
			"default": false
		},
		"show-fps": {
			"type": "bool",
			"name": "Show FPS",
			"default": false
		},
		"show-clock": {
			"type": "bool",
			"name": "Show clock",
			"default": false
		},
		"fx-mirror": {
			"type": "bool",
			"name": "Mirror screen",
			"default": false
		},
		"fx-flip": {
			"type": "bool",
			"name": "Flip screen",
			"default": false
		},
		"fx-spin": {
			"type": "int",
			"name": "Spin screen",
			"default": 0,
			"min": 0,
			"max": 10
		}
	}
}
